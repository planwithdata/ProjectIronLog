      { "weekday": 4, "day": "Thursday", "label": "Legs" },
      { "weekday": 5, "day": "Friday", "label": "Recovery" },
      { "weekday": 6, "day": "Saturday", "label": "Upper" },
      { "weekday": 7, "day": "Sunday", "label": "Posterior Chain" }
    ]
  },

  "progression": {
    "type": "double-progression",
    "summary": "Work within a rep range instead of chasing a fixed number. Progress the weight only once you have earned it.",
    "rules": [
      "Pick a starting weight where the last 1-2 reps of your first set feel genuinely hard, but every rep is done with good form.",
      "Each session, try to add one rep to any set that is below the top of its rep range, keeping the same weight.",
      "Once you complete the top of the rep range for ALL working sets, increase the weight by that exercise's increment and drop back to the bottom of the rep range.",
      "If you do NOT hit the top of the rep range yet, repeat the previous session's weight. The '+X kg' notes are a ceiling on how much to add, not a requirement to add it on schedule.",
      "For bodyweight moves marked 'add reps first', do not add external weight until you are comfortably hitting the top of the rep range - then add a small amount via a dip belt or weighted vest."
    ],
    "stall": {
      "sessionsBeforeDeload": 3,
      "loadDropPercent": 10,
      "note": "If a lift stalls for 3 straight sessions with no rep or weight increase, drop the weight about 10% and rebuild. This is normal, not a failure."
    },
    "warmup": {
      "rampUpSets": [2, 3],
      "appliesTo": ["compound"],
      "note": "Warm up compound lifts with 2-3 ramp-up sets before your first working set. These are not counted as working sets."
    }
  },

  "generalRules": [
    "Warm up compound lifts (Squat, RDL, Bench/Incline Press) with 2-3 ramp-up sets before your first working set - these aren't counted in the sets above.",
    "If a lift stalls for 3 straight sessions (no rep or weight increase), drop the weight ~10% and rebuild - this is normal, not a failure.",
    "Sleep and protein intake drive whether this progression scheme actually works. Without them, added weight on the bar will stall regardless of effort in the gym."
  ],

  "missedDayRules": [
    "Treat the split as rolling, not calendar-locked - if you miss Thursday's Legs day, just do it Friday, and every day after shifts back by one.",
    "Avoid stacking two heavy sessions for the same muscle group back-to-back - leave at least a day of gap between them where possible.",
    "If a missed day would otherwise force 3 straight lifting days in a row, drop that week's Friday recovery walk/mobility session instead of skipping a lifting day.",
    "If you miss two days in a row, don't cram both sessions back-to-back - just resume the split from wherever you are and let the missed session roll into next week.",
    "Don't add extra volume elsewhere to 'make up' for a skipped muscle group - one missed session per month has minimal impact on progress; doubling up elsewhere risks overtraining."
  ],

