      "bodyWeightKg": 85,
      "note": "Lean bulk target. Settings > Profile takes precedence if a goal is entered there."
    },
    "wave": {
      "loadingWeeks": 4,
      "deloadWeek": 5,
      "deload": {
        "setReductionPercent": 40,
        "loadPercentMin": 60,
        "loadPercentMax": 70,
        "note": "Cut sets by roughly 40% on every exercise (4 sets to 2, 3 sets to 2) and use 60-70% of your Week 4 weight. After the deload, restart at Week 1 from wherever you left off pre-deload."
      }
    },
    "weeklySplit": [
      { "weekday": 1, "day": "Monday", "label": "Rest" },
      { "weekday": 2, "day": "Tuesday", "label": "Chest Priority" },
