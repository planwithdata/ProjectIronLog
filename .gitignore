# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp

# Agent / tooling scratch
.claude/
.smoke.*
*.log

# Document-extraction working files. The source .docx and .pdf are committed;
# these intermediates are regenerable and only clutter diffs.
.pdfpages/
.pdfimgs/
pdf_dump.txt
docx_dump.txt
tools/exercise-image-map.json

# Generated reports (exports land here at the user's choosing)
reports/*
!reports/.gitkeep

# Real training data. `tools/test-migration.mjs` uses a backup from this
# directory as a fixture when one is present, and skips that test when it is
# not — so the file stays local and never lands in a commit.
ironlog-backup-*.json
pre-upgrade-*.json

# There is no build step and no dependencies — node_modules should never exist.
node_modules/
